{
  "agents": [
    {
      "id": "claude",
      "label": "Claude Code (Anthropic)",
      "command": "claude",
      "runtime": "claude",
      "extraArgs": [
        "--dangerously-skip-permissions",
        "--print",
        "--output-format",
        "stream-json",
        "--verbose"
      ],
      "execArgs": [
        "--dangerously-skip-permissions",
        "--print",
        "--output-format",
        "stream-json",
        "--verbose"
      ],
      "nonInteractiveTokens": [
        "--print"
      ],
      "promptDelivery": "system-prompt-file",
      "rulesSupported": true,
      "resumeCommand": [
        "--continue"
      ]
    },
    {
      "id": "claude-ds",
      "label": "Claude Code (DeepSeek)",
      "command": "claude-ds",
      "extends": "claude"
    },
    {
      "id": "claude-ds-pro",
      "label": "Claude Code (DeepSeek Pro)",
      "command": "claude-ds-pro",
      "extends": "claude"
    },
    {
      "id": "reasonix",
      "label": "Reasonix Code",
      "command": "reasonix",
      "runtime": "claude",
      "extraArgs": [
        "run"
      ],
      "execArgs": [
        "run",
        "--dir",
        "{workspace}"
      ],
      "nonInteractiveTokens": [
        "run"
      ],
      "execPromptDelivery": "positional",
      "dynamicCommand": true,
      "promptDelivery": "positional",
      "rulesSupported": false,
      "resumeCommand": [
        "--continue"
      ]
    },
    {
      "id": "agy",
      "label": "Antigravity",
      "command": "agy",
      "runtime": "agy",
      "extraArgs": [
        "--dangerously-skip-permissions",
        "--print-timeout",
        "30m0s"
      ],
      "execArgs": [
        "--dangerously-skip-permissions",
        "--print-timeout",
        "30m0s"
      ],
      "execPromptDelivery": "flag",
      "execPromptFlag": "--print",
      "promptDelivery": "flag",
      "promptFlag": "--print",
      "rulesSupported": false,
      "resumeCommand": [
        "--continue"
      ]
    },
    {
      "id": "codex",
      "label": "Codex (OpenAI)",
      "command": "codex",
      "runtime": "codex",
      "extraArgs": [
        "exec",
        "--skip-git-repo-check",
        "--dangerously-bypass-approvals-and-sandbox"
      ],
      "execArgs": [
        "exec",
        "--skip-git-repo-check",
        "--cd",
        "{workspace}",
        "--dangerously-bypass-approvals-and-sandbox"
      ],
      "nonInteractiveTokens": [
        "exec"
      ],
      "promptDelivery": "positional",
      "rulesSupported": false,
      "resumeCommand": [
        "exec",
        "resume",
        "--last"
      ]
    },
    {
      "id": "codex-pro",
      "label": "Codex Pro (OpenAI)",
      "command": "codex-pro",
      "extends": "codex"
    },
    {
      "id": "agy-interactive",
      "label": "Antigravity (interactive)",
      "command": "agy",
      "runtime": "agy",
      "extraArgs": [
        "--dangerously-skip-permissions"
      ],
      "promptDelivery": "flag",
      "promptFlag": "--prompt-interactive",
      "rulesSupported": false,
      "resumeCommand": [
        "--continue"
      ]
    }
  ],
  "skillAgentMap": {
    "gh-maestro-coder": "claude-ds",
    "gh-maestro-base": "claude-ds",
    "gh-maestro-senior-coder": "claude-ds-pro",
    "gh-maestro-investigator": "reasonix",
    "gh-maestro-explorer": "agy",
    "gh-maestro-reviewer": "codex",
    "gh-maestro-architect": "codex-pro"
  }
}
