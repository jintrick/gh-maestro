{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "expectedItemCount", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "expectedItemCount": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "generation",
          "scope",
          "requiredCapabilities",
          "description",
          "cleanupId",
          "integrationStatus"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "generation": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "string",
            "enum": ["repository", "workspace", "managed", "runtime", "mixed"]
          },
          "requiredCapabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "description": { "type": "string", "minLength": 1 },
          "cleanupId": { "type": "string", "minLength": 1 },
          "integrationStatus": {
            "type": "string",
            "enum": ["integrated", "pending"]
          }
        }
      }
    }
  }
}
