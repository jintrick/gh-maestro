{
  "name": "gh-maestro",
  "version": "0.1.0",
  "description": "gh-maestro session monitors and orchestrator turn hooks",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^gh-maestro$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator-turn-hook.js",
              "mark"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator-turn-hook.js",
              "prompt"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator-turn-hook.js",
              "stop"
            ],
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
